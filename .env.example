# Copy this file to .env and fill in your own key. Never commit .env.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Everything below is optional.

# Language model backend: gemini (default) or ollama
# BT_BACKEND=gemini
# BT_MODEL=gemini-2.5-flash
# OLLAMA_HOST=http://localhost:11434

# How many past exchanges BT sends to the model for context
# BT_HISTORY_TURNS=10

# Speech recognition model: tiny.en (fastest), base.en, small.en (most accurate)
# BT_WHISPER_MODEL=base.en

# Where pilot data (memory.json) is stored
# BT_DATA_DIR=~/.bt7274

# Path to the Piper voice model
# BT_VOICE_MODEL=voice_model/BT7274.onnx
